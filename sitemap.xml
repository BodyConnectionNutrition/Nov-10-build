---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for page in site.pages %}{% if page.url and page.url != '/404.html' and page.noindex != true and page.sitemap != false %}<url><loc>{{ site.url }}{{ page.url }}</loc></url>{% endif %}{% endfor %}
{% for post in site.posts %}{% if post.noindex != true %}<url><loc>{{ site.url }}{{ post.url }}</loc><lastmod>{{ post.date | date_to_xmlschema }}</lastmod></url>{% endif %}{% endfor %}
</urlset>
